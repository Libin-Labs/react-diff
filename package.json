{
  "name": "@lp-labs/react-diff",
  "version": "1.0.0",
  "description": "Budgeted deterministic line diffs with accessible controlled React views.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2020 --types react --skipLibCheck false tests/consumer.mts tests/consumer.cts"
  },
  "peerDependencies": {
    "react": "^18.2 || ^19"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "author": {
    "name": "Libin Prasanth",
    "url": "https://www.linkedin.com/in/libinprasanth/"
  },
  "funding": {
    "type": "paypal",
    "url": "https://www.paypal.me/LibinPrasanth"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "keywords": [
    "react",
    "diff",
    "text",
    "typescript"
  ]
}
